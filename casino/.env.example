# =================================================================
# FRONTEND PRODUCTION ENVIRONMENT CONFIGURATION (Vercel)
# =================================================================

# Backend API Base URL (Render backend URL, e.g. https://your-backend-app.onrender.com)
VITE_API_BASE_URL=https://your-backend-app.onrender.com

# WebSocket Server URL for real-time multiplayer updates
VITE_SOCKET_URL=https://your-backend-app.onrender.com

# Application Brand Identity
VITE_APP_NAME="Casino Gaming Platform"
VITE_APP_VERSION=1.0.0

# Optional Analytics & Error Monitoring
VITE_GA_TRACKING_ID=
VITE_SENTRY_DSN=

# Development / Debug Flags (Must be false in production)
VITE_DEV_MODE=false
VITE_DEBUG=false
VITE_GAME_LAUNCH_TEST_MODE=false
VITE_GAME_TEST_MODE=false

# Feature Toggles
VITE_ENABLE_SPORTS_BETTING=true
VITE_ENABLE_CASINO=true
VITE_ENABLE_AFFILIATE=true
VITE_ENABLE_VIP=true

# Optional CDN & Asset Base URLs
VITE_ASSETS_URL=
VITE_LOGO_URL=/logo.svg

# Supabase Credentials (if direct frontend database access is required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
