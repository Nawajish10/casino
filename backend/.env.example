# =================================================================
# BACKEND PRODUCTION ENVIRONMENT CONFIGURATION (Render / Railway)
# =================================================================

# Server Port (Render dynamically assigns PORT in production, default 3000)
PORT=3000

# Node Environment ('production' or 'development')
NODE_ENV=production

# Frontend URL(s) allowed for CORS (comma-separated if multiple, e.g. https://your-app.vercel.app,https://yourdomain.com)
FRONTEND_URL=https://your-frontend-app.vercel.app

# Enable Swagger API docs in production ('true' or 'false')
ENABLE_SWAGGER=false

# =================================================================
# DATABASE CONFIGURATION (Supabase PostgreSQL / PgBouncer)
# =================================================================

# Pooled Database URL (used for application runtime queries via PgBouncer, port 6543)
DATABASE_URL="postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Database URL (used for Prisma migrations and schema sync, port 5432)
DIRECT_URL="postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Supabase API Credentials
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# =================================================================
# AUTHENTICATION & JWT KEYS
# =================================================================

# Strong random secret strings for signing access and refresh tokens
JWT_SECRET=replace_with_a_long_random_secure_jwt_secret_key_32bytes
JWT_REFRESH_SECRET=replace_with_a_long_random_secure_jwt_refresh_secret_key_32bytes

# =================================================================
# GAME PROVIDER API INTEGRATION (Nexus / External Gateways)
# =================================================================

PROVIDER_GATEWAY_URL=https://api.nexusggr.dev
PROVIDER_AGENT_CODE=your_agent_code
PROVIDER_AGENT_TOKEN=your_agent_token
PROVIDER_SECRET=your_provider_secret
PROVIDER_SITE_ENDPOINT=https://your-domain.com
GAME_LAUNCH_TEST_MODE=false
GAME_TEST_MODE=false

# =================================================================
# THIRD-PARTY SERVICES (SMS & SMTP Email Notifications)
# =================================================================

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
